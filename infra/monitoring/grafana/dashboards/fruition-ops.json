{
  "uid": "fruition-ops",
  "title": "Fruition 운영",
  "description": "Google SRE Four Golden Signals(Latency·Traffic·Errors·Saturation) 배치. 인과 순서대로 Traffic → Saturation → Latency → Errors로 읽는다. 여기서 이상이 잡히면 JVM (Micrometer) 대시보드로 넘어간다.",
  "tags": [
    "fruition"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "consumergroup",
        "label": "Consumer group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kafka_consumergroup_lag, consumergroup)",
        "query": "label_values(kafka_consumergroup_lag, consumergroup)",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "ingest-worker",
          "value": "ingest-worker",
          "selected": true
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① Traffic — 지금 얼마나 들어오고 있나",
      "description": "다른 세 신호를 해석하는 기준선이다. 이것 없이는 'p95가 3배 느려졌다'가 요청이 늘어서인지 코드가 느려져서인지 구분할 수 없고, 에러 건수도 비율로 환산할 수 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (application) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{application}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_requests_total{job=\"pipeline-api\"}[5m]))",
          "legendFormat": "pipeline-api"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② Saturation — 자원이 한계에 얼마나 가까운가",
      "description": "Kafka lag은 비동기 파이프라인의 포화도다(왼쪽 축, 건수). 올랐다 0으로 내려오면 정상, 안 내려오면 워커 정지·반복 실패다. 점선은 KEDA 스케일 발동선(5). DB 커넥션 사용률은 오른쪽 축이며 1.0에 붙으면 풀(기본 10개)이 마른 것이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*DB 사용률.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "lag {{consumergroup}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "hikaricp_connections_active / hikaricp_connections_max",
          "legendFormat": "DB 사용률 {{application}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "③ Latency — 요청 처리에 걸리는 시간",
      "description": "p95와 p99를 함께 본다. 평균은 느린 소수를 숨긴다. 절대값보다 배포 전후 변화를 본다 — 평소의 3~5배면 조사한다. 트래픽이 없으면 rate 분모가 0이라 선이 끊기는데 정상이다. uri별 분해는 Explore에서 sum by에 uri를 함께 넣어 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95 {{application}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p99 {{application}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"pipeline-api\"}[5m])))",
          "legendFormat": "p95 pipeline-api"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"pipeline-api\"}[5m])))",
          "legendFormat": "p99 pipeline-api"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "④ Errors — 실패하는 요청의 비율",
      "description": "건수가 아니라 비율이다. 5xx 10건은 요청 100건 중이면 재앙이고 100만 건 중이면 무시할 수준이다. 4xx는 뺀다 — 미로그인 401은 정상 동작이라 신호가 되지 않는다. 주의: 여기 잡히는 것은 '명시적 실패'뿐이다. AI 처리는 202로 즉시 응답한 뒤 비동기로 실패할 수 있어 이 그래프가 평평해도 사용자는 결과를 못 받을 수 있다. 그 경우는 ERROR 로그(오른쪽 축)에 먼저 나타난다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ERROR 로그.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (application) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx 비율 {{application}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_requests_total{job=\"pipeline-api\", status=\"5xx\"}[5m])) / sum(rate(http_requests_total{job=\"pipeline-api\"}[5m]))",
          "legendFormat": "5xx 비율 pipeline-api"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (application) (rate(logback_events_total{level=\"error\"}[5m]))",
          "legendFormat": "ERROR 로그 {{application}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "└ 드릴다운 · partition별 lag ($consumergroup)",
      "description": "②에서 특정 consumer group이 밀릴 때 어느 partition인지 좁힌다. 메시지 key가 document_id라 partition은 문서 단위로 묶인다 — 한 partition만 쌓여 있으면 그 partition에 걸린 특정 문서가 반복 실패하는 것이다. 전 partition이 고르게 쌓이면 처리량 부족이다. 상단 Consumer group 드롭다운으로 대상을 바꾼다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kafka_consumergroup_lag{consumergroup=\"$consumergroup\"}",
          "legendFormat": "partition {{partition}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "재시작 · 배포",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "(time() - process_start_time_seconds) < 300",
        "target": {
          "refId": "Anno",
          "expr": "(time() - process_start_time_seconds) < 300"
        },
        "step": "5m",
        "titleFormat": "재시작",
        "textFormat": "{{job}} {{application}}{{instance}}",
        "tagKeys": "job,application"
      }
    ]
  },
  "fieldConfig": {}
}