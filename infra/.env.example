APP_ENV=development
WEB_ORIGIN=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PostgreSQL admin (컨테이너 슈퍼유저 — DB·계정 초기화 전용, 앱 접속 금지)
POSTGRES_ADMIN_USER=fruition_admin
POSTGRES_ADMIN_PASSWORD=fruition_admin_dev_password

# access_db — access-svc 전용 (runtime=DML, migration=flyway)
ACCESS_DB_NAME=access_db
ACCESS_DB_RUNTIME_USER=access_runtime
ACCESS_DB_RUNTIME_PASSWORD=access_runtime_dev_password
ACCESS_DB_MIGRATION_USER=access_migration
ACCESS_DB_MIGRATION_PASSWORD=access_migration_dev_password
ACCESS_DATABASE_URL=postgresql://access_runtime:access_runtime_dev_password@localhost:5432/access_db

# core_db — document-svc 전용 (runtime=DML, migration=flyway)
CORE_DB_NAME=core_db
CORE_DB_RUNTIME_USER=core_runtime
CORE_DB_RUNTIME_PASSWORD=core_runtime_dev_password
CORE_DB_MIGRATION_USER=core_migration
CORE_DB_MIGRATION_PASSWORD=core_migration_dev_password
CORE_DATABASE_URL=postgresql://core_runtime:core_runtime_dev_password@localhost:5432/core_db
# Wiki maintenance cutover 전용. 앱 runtime에는 전달하지 않는다.
CORE_DB_MIGRATION_URL=postgresql://core_migration:core_migration_dev_password@localhost:5432/core_db

# ai_db — ai-svc 전용
AI_DB_NAME=ai_db
AI_DB_RUNTIME_USER=ai_runtime
AI_DB_RUNTIME_PASSWORD=ai_runtime_dev_password
AI_DB_MIGRATION_USER=ai_migration
AI_DB_MIGRATION_PASSWORD=ai_migration_dev_password
AI_DATABASE_URL=postgresql://ai_runtime:ai_runtime_dev_password@localhost:5432/ai_db
# pipeline-api 기동 시 db/ai_schema.sql(멱등)을 적용하는 계정. 비우면 적용을 건너뛴다.
AI_DB_MIGRATION_URL=postgresql://ai_migration:ai_migration_dev_password@localhost:5432/ai_db

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=fruition-storage
S3_ACCESS_KEY=fruition
S3_SECRET_KEY=fruition_dev_secret
S3_FORCE_PATH_STYLE=true

# Redis (다중 인스턴스 공유 store: OAuth 교환 코드, query run 상태·SSE 이벤트 중계)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka (AI 비동기 command 큐). 호스트 실행 backend는 localhost, 컨테이너는 kafka:19092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
INGEST_COMMAND_TOPIC=ai.ingest.command
QUERY_COMMAND_TOPIC=ai.query.command
AGENT_COMMAND_TOPIC=ai.agent.command
MAINTENANCE_COMMAND_TOPIC=ai.maintenance.command
AI_TASK_EVENT_TOPIC=ai.task.event

# ai-svc secret (provider/model/base URL은 API·DB snapshot에서 결정)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
WIKI_SEMANTIC_MAX_WORKERS=4
AGENT_SKILLS_ENABLED=true
SKILL_API_ENABLED=true
AGENT_INTERNAL_TOKEN=local-agent-internal
# llmPipeline이 작업 결과 콜백에 실어 보내는 내부 토큰. document-svc·access-svc와 값이 같아야 한다.
INTERNAL_CALLBACK_TOKEN=local-internal-callback

# 백엔드 분리: access-svc(:8081, 인증·워크스페이스 CRUD) / document-svc(:8080, 나머지 기능 경로)
ACCESS_PORT=8081
# document-svc -> access-svc 내부 호출 (/internal/authz, /internal/users)
ACCESS_INTERNAL_BASE_URL=http://localhost:8081
# access-svc -> document-svc 내부 호출 (/internal/workspaces/*/initial-note)
DOCUMENT_INTERNAL_BASE_URL=http://localhost:8080
# 프론트엔드가 OAuth 시작·access-svc rewrite에 쓰는 오리진. 기본 http://localhost:8081.
# 값을 바꾸려면 frontend 환경변수 NEXT_PUBLIC_ACCESS_URL로 지정한다.
# 복구 미리보기 토큰 서명 키. 백엔드를 여러 대로 띄울 때만 채우면 된다.
RESTORE_PREVIEW_TOKEN_SECRET=

# Pipeline API
PROCESSING_ENDPOINT=http://localhost:8000/pipeline/runs
QUERY_ENDPOINT=http://localhost:8000/query
QUERY_TIMEOUT_SECONDS=30
AGENT_RUN_ENDPOINT=http://localhost:8000/agent/runs
SKILL_ENDPOINT=http://localhost:8000/skills

# PDF → Markdown 변환기(compose.converter.yml의 markitdown, 호스트 포트 127.0.0.1:8010)
# 로컬 호스트 bootRun용 값. 컨테이너 실행(deploy.yml)에서는 http://markitdown:8000이 주입된다.
CONVERTER_ENDPOINT=http://localhost:8010

PIPELINE_API_PORT=8000
POST_INGEST_EVIDENCE_LIMIT=3
QUERY_EMBEDDING_MODE=bge-m3
QUERY_EVIDENCE_LIMIT=8

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=local-pilot-dev
# Default US: https://api.smith.langchain.com
# APAC/Sydney: https://apac.api.smith.langchain.com
# EU: https://eu.api.smith.langchain.com
# AWS US: https://aws.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Web 검색을 허용한 Query만 근거·Web 전환을 평가합니다. 전체 Query는 llm, 비활성화는 disabled입니다.
QUERY_EVALUATOR_MODE=web
QUERY_EVALUATOR_MAX_ATTEMPTS=2

# Query web fallback
TAVILY_API_KEY=
QUERY_WEB_SEARCH_MAX_RESULTS=5
QUERY_WEB_SEARCH_TIMEOUT_SECONDS=20
QUERY_MIN_INTERNAL_RELEVANCE_SCORE=0.5

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=1209600
# HTTPS 배포에서만 true. 로컬 HTTP에서는 false를 유지한다.
AUTH_REFRESH_COOKIE_SECURE=false

# 로컬 이메일 인증 고정 코드. 운영 환경에서는 설정하지 않습니다.
AUTH_EMAIL_DEV_FIXED_CODE=9700

# 이메일 발송(SMTP). 아래를 설정하면 dev 로그 stub 대신 실제 SMTP 발송으로 전환됩니다.
# provider 무관(SES SMTP / SendGrid SMTP / Gmail 등) — SMTP 계정만 있으면 됩니다.
# 로컬 개발에서는 비워두면 stub(고정코드 9700)으로 동작합니다.
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=no-reply@example.com
# SMTP timeout(ms). 기본 5000. 필요 시 오버라이드.
# MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
# MAIL_SMTP_TIMEOUT_MS=5000
# MAIL_SMTP_WRITE_TIMEOUT_MS=5000

# OAuth2 (docs/spec/oauth-provider-setup.md 참고)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
OAUTH_FRONTEND_REDIRECT_URI=http://localhost:3000/oauth/callback

# MFA(TOTP) secret 암호화 키. base64로 인코딩한 32바이트여야 하며, 없으면 access-svc 부팅에 실패한다.
# 생성: openssl rand -base64 32
# 이 키를 잃어버리면 등록된 MFA secret을 복호화할 수 없어 사용자가 전부 복구 코드로 들어와야 한다.
MFA_ENCRYPTION_KEY=
# 인증 앱에 표시될 발급자 이름.
MFA_ISSUER=Fruition

# 워크스페이스 초대 링크. 메일에는 {WORKSPACE_INVITATION_ACCEPT_URL}/{token} 형태로 실린다.
# 배포 환경에서는 실제 프론트엔드 도메인으로 바꿔야 링크가 동작한다.
WORKSPACE_INVITATION_ACCEPT_URL=http://localhost:3000/invitations
# 초대 만료(초). 기본 7일.
WORKSPACE_INVITATION_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000
