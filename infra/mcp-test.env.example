# Non-secret inputs for scripts/mcp-test-up.sh. The script creates secrets under
# /tmp/fruition-mcp-test by default and never reads infra/.env.
MCP_TEST_PROJECT=fruition-mcp-test
MCP_TEST_RUNTIME_DIR=/tmp/fruition-mcp-test
MCP_TEST_ORIGIN=https://localhost:58443

MCP_TEST_POSTGRES_PORT=55490
MCP_TEST_REDIS_PORT=56380
MCP_TEST_KAFKA_PORT=59092
MCP_TEST_MINIO_PORT=59050
MCP_TEST_MINIO_CONSOLE_PORT=59051
MCP_TEST_PIPELINE_PORT=58000
MCP_TEST_DOCUMENT_PORT=58080
MCP_TEST_ACCESS_PORT=58081
MCP_TEST_FRONTEND_PORT=58300
MCP_TEST_GATEWAY_HTTP_PORT=58480
MCP_TEST_GATEWAY_HTTPS_PORT=58443

# Local consent UI: the up script copies current dirty frontend source into the
# private runtime and links this already-installed dependency tree. It performs
# no npm install and creates no Next output in the checkout.
MCP_TEST_FRONTEND_DIR=/Users/jaehyeong/Fruition-frontend/web
MCP_TEST_FRONTEND_DEPENDENCIES_DIR=/tmp/fruition-mcp-supervision/upstream-integration/frontend-candidate/web/node_modules

# The local synthetic client metadata URL is served by the test gateway. Access
# intentionally refuses to fetch it while it resolves to loopback. OAuth consent
# becomes runnable only after an approved public HTTPS origin is configured.
MCP_TEST_CLIENT_REDIRECT_URI=http://127.0.0.1/callback

# Optional exact Claude/other CIMD URL. Do not guess it: the seed helper only
# allowlists this value when explicitly supplied by the tester.
MCP_TEST_REAL_CLIENT_ID=
