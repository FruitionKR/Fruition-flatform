# 복사해서 loadtest/.env 로 쓰고(.env는 git이 무시한다) `set -a; . ./.env; set +a` 후 k6 run 한다.
# 비밀 값(ACCESS_CODE)은 Secrets Manager에서 실행 직전에 읽고, 저장소·셸 기록에 남기지 않는다.

# 대상(필수). 화면과 API가 같은 출처인 app_domain을 쓴다. 로컬이면 http://localhost:3000
BASE_URL=https://web.example.org
# 로컬이 아니면 BASE_URL의 호스트를 한 번 더 적어야 실행된다(오타·운영 대상 실수 방지).
CONFIRM_TARGET=web.example.org

# WAF frontend-access-code 규칙 통과용 접근 코드(평문). k6가 sha256 hex로 fruition_access 쿠키를 만든다.
ACCESS_CODE=

# 시험 전용 계정 목록 파일(loadtest/ 기준 상대 경로 또는 절대 경로). 형식은 accounts.example.json
ACCOUNTS_FILE=accounts.json
# 또는 파일 대신 JSON 문자열: ACCOUNTS_JSON=[{"email":"...","password":"..."}]

# 실행 식별자. 시드 워크스페이스 이름 k6-loadtest-<RUN_ID>
RUN_ID=
# 계정마다 만들 Markdown 문서 수
SEED_DOCS=10

# LLM 비용 가드. 0이면 질의를 보내지 않는다(기본). 0~1 비율 × 채팅 행동(전체의 5%)
LLM_SHARE=0
LLM_MAX_PER_VU=1
# 비우면 워크스페이스 기본 모델을 쓴다
QUERY_PROVIDER=
QUERY_MODEL=

# 행동 사이 대기(초)
THINK_MIN_S=1
THINK_MAX_S=3

# 시나리오별 조절값(기본값은 각 스크립트 상단)
SMOKE_VUS=1
SMOKE_DURATION=1m
LOAD_RATE=3
LOAD_HOLD=10m
STRESS_START_RATE=5
STRESS_STEPS=5
STRESS_STEP_HOLD=3m
SPIKE_BASE_RATE=2
SPIKE_MULTIPLIER=10
SPIKE_HOLD=2m
SOAK_RATE=2
SOAK_DURATION=90m

# meeting-ws.js 전용(기본 꺼짐). 접속만 해도 AI 실시간 전사 연결·크레딧 예약이 생긴다.
MEETING_WS_ENABLED=0
MEETING_VUS=1
MEETING_ITERATIONS=1
MEETING_AUDIO_SECONDS=0
